{
  "name": "talo-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:api": "NEXT_DIST_DIR=.next-api next dev -p 3001",
    "dev:front": "NEXT_DIST_DIR=.next-front API_PROXY_ORIGIN=http://127.0.0.1:3001 next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:cli": "cli/.venv/bin/pytest -q cli/tests",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run test:cli && npm run build"
  },
  "dependencies": {
    "lucide-react": "^1.27.0",
    "next": "^16.2.12",
    "next-intl": "^4.13.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.32.0",
    "eslint-config-next": "^16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
